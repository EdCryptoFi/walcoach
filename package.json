{
  "name": "walrus-coach-bot",
  "version": "0.1.0",
  "description": "A Telegram coaching companion that remembers you across sessions using Walrus Memory",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/telegram.ts",
    "start": "tsx src/web.ts",
    "check": "tsx scripts/check.ts",
    "stats": "tsx scripts/stats.ts",
    "typecheck": "tsc --noEmit",
    "eval": "LOG_MEMORIES=1 tsx scripts/eval.ts",
    "web": "tsx src/web.ts",
    "web:dev": "LOG_MEMORIES=1 tsx watch src/web.ts",
    "telegram": "tsx src/telegram.ts",
    "vercel-build": "npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o public/app.css --minify",
    "logs": "tail -n 50 logs/app.log",
    "logs:errors": "tail -n 50 logs/error.log"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@mysten-incubation/memwal": "^0.1.7",
    "@mysten/seal": "^1.1.0",
    "@mysten/sui": "^2.5.0",
    "@vercel/functions": "^3.9.8",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "hono": "^4.13.8",
    "openai": "^4.77.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}