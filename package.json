{
  "name": "walrus-coach-bot",
  "version": "0.1.0",
  "description": "A Telegram coaching companion that remembers you across sessions using Walrus Memory",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsx scripts/check.ts",
    "stats": "tsx scripts/stats.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.7",
    "@mysten/seal": "^1.1.0",
    "@mysten/sui": "^2.5.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}