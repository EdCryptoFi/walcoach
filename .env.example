# Web server port
PORT=3000

# Telegram (optional) — create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=

# Groq — free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Walrus Memory — create an account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Prefix for per-user namespaces (namespace = <prefix>-<telegram user id>)
MEMWAL_NAMESPACE_PREFIX=coach

# Optional: how the coach introduces itself
BOT_NAME=Coach

# Who extracts facts from conversations: "llm" (our model, default) or "relayer" (Walrus Memory analyze API)
MEMORY_EXTRACTOR=llm
