# Web server port
PORT=3000

# Telegram (optional) — create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=

# Groq — free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Walrus Memory — create an account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Prefix for per-user namespaces (namespace = <prefix>-<telegram user id>)
MEMWAL_NAMESPACE_PREFIX=coach

# Optional: how the coach introduces itself
BOT_NAME=Coach

# Who extracts facts from conversations: "llm" (our model, default) or "relayer" (Walrus Memory analyze API)
MEMORY_EXTRACTOR=llm

# Print memory texts in server logs (off by default: memories are personal)
LOG_MEMORIES=0

# Web Push (proactive nudges). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/nudge; Vercel sends it automatically for scheduled runs
CRON_SECRET=

# Tavily web search (optional, free key at tavily.com). Without it the coach answers from memory + model knowledge only.
TAVILY_API_KEY=

# Per-user Walrus Memory accounts (level 2). Sponsor wallet pays gas for account creation only.
SUI_SPONSOR_KEY=
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
